# ───── 필수 ─────
# 디스코드 개발자 포털 > Bot > Reset Token 으로 발급
DISCORD_TOKEN=여기에_디스코드_봇_토큰을_붙여넣으세요

# https://openrouter.ai/keys 에서 발급
OPENROUTER_API_KEY=sk-or-v1-여기에_오픈라우터_키를_붙여넣으세요

# ───── 선택 (없으면 기본값 사용) ─────
# 사용할 모델 ID. https://openrouter.ai/models 에서 확인
OPENROUTER_MODEL=google/gemini-2.5-flash

BOT_NAME=제미나이
# SYSTEM_PROMPT=당신은 친절한 AI 도우미 제미나이입니다.

# 채널당 기억할 대화 턴 수
HISTORY_TURNS=10
# 응답 대기 제한 시간(밀리초)
REQUEST_TIMEOUT_MS=60000
# 답변 최대 토큰
MAX_TOKENS=1500

# ───── 배포 환경용 (로컬에서는 비워두세요) ─────
# 설정 파일을 저장할 경로. Northflank에서 볼륨을 /data 에 붙였다면 /data
# DATA_DIR=/data
# 볼륨 없이 배포할 때, 봇이 답변할 채널 ID를 쉼표로 나열 (재배포해도 유지됨)
# ACTIVE_CHANNEL_IDS=123456789012345678
# 헬스체크 HTTP 서버 포트 (설정하면 해당 포트로 상태 확인 가능)
# PORT=8080
